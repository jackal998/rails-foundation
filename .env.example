# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
# THIS FILE IS COMMITTED TO A PUBLIC REPOSITORY. It documents which variables
# exist. It must never contain a real value - not a weak one, not a temporary
# one, not "just for now". Put values in .env.

# Password for the local development Postgres container in compose.yaml.
# Local only: the container is bound to 127.0.0.1 and this password never
# leaves the machine. Generate one rather than typing a word:
#   ruby -rsecurerandom -e 'puts SecureRandom.alphanumeric(24)'
POSTGRES_PASSWORD=
