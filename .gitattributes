# Normalise line endings so a Windows checkout cannot write CRLF into files
# that Linux containers execute. Without this, `bin/rails` checked out on
# Windows gets \r\n on its shebang line and the container fails with the
# famously misleading `no such file or directory` — pointing at the
# interpreter, not at the file you actually broke.
* text=auto eol=lf

# Belt and braces for everything executed inside a container or by a shell.
bin/*           text eol=lf
*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
docker-entrypoint text eol=lf

# Binary — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary

# --- from the Rails 8.1 generator, folded in 2026-08-23 ---
# Keeps generated files out of GitHub's language statistics.
db/schema.rb    linguist-generated
vendor/**       linguist-vendored

# Makes `git diff` on encrypted credentials show the DECRYPTED diff instead of
# unreadable ciphertext -- but ONLY once the driver exists in the local git
# config, and it is per-clone, not something this file can bring with it.
# Without it git shows ciphertext and says nothing about why. Verified absent
# in the clone this was written in, so treat it as off until you have run:
#   git config diff.rails_credentials.textconv "bin/rails credentials:diff"
config/credentials.yml.enc      diff=rails_credentials
config/credentials/*.yml.enc    diff=rails_credentials
