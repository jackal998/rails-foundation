#!/bin/bash -e

# Prepare the database when this container is starting the Rails server.
#
# The generated version of this test compared the LAST TWO arguments to
# "./bin/rails" and "server" exactly, which holds for the Dockerfile's current
# CMD and stops holding the moment anyone appends a flag: `./bin/rails server
# -b 0.0.0.0` would skip preparation entirely and boot against whatever schema
# happened to be there. The failure would be a missing column at runtime, well
# away from the change that caused it, so the test matches the subcommand
# wherever it appears instead of only at the end.
case " $* " in
  *" ./bin/rails server"*) needs_database=yes ;;
  *)                       needs_database=no ;;
esac

if [ "$needs_database" = "yes" ]; then
  ./bin/rails db:prepare

  # db:prepare cannot create the Solid Cache / Queue / Cable tables when
  # their databases already exist -- which is always true when one managed
  # database backs all four roles. Read bin/prepare-solid-databases before
  # touching this: without it the container exits with code 0 and looks
  # like a clean shutdown.
  ./bin/prepare-solid-databases
fi

exec "${@}"
